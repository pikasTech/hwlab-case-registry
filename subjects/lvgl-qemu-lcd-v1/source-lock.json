{
  "schemaVersion": 1,
  "baselineId": "qemu-lcd-lvgl-v1",
  "sources": {
    "lvgl": {
      "repository": "https://github.com/lvgl/lvgl.git",
      "ref": "v9.2.2",
      "commit": "7f07a129e8d77f4984fff8e623fd5be18ff42e74",
      "destination": "third_party/lvgl"
    },
    "qemu": {
      "package": "qemu-system-arm",
      "machine": "vexpress-a9",
      "cpu": "cortex-a9",
      "displayController": "pl111"
    }
  },
  "toolchain": {
    "compiler": "arm-none-eabi-gcc",
