#!/bin/sh
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
arm2d="$root/third_party/Arm-2D"
mkdir -p "$root/build"

set -- \
  "$root/src/main.c" \
  "$root/src/arm_2d_disp_adapter_0.c" \
  "$arm2d/examples/demos/arm_2d_scene_basics.c" \
  "$arm2d/examples/common/asset_DigitsFont.c" \
  "$arm2d/Library/Source/arm_2d.c" \
  "$arm2d/Library/Source/arm_2d_alpha_blending.c" \
  "$arm2d/Library/Source/arm_2d_async.c" \
  "$arm2d/Library/Source/arm_2d_conversion.c" \
  "$arm2d/Library/Source/arm_2d_draw.c" \
  "$arm2d/Library/Source/arm_2d_transform.c" \
  "$arm2d/Platform/math/arm_common_tables.c" \
  "$arm2d/Platform/math/arm_cos_f32.c" \
  "$arm2d/Platform/math/arm_cos_q31.c" \
  "$arm2d/Platform/math/arm_sin_f32.c" \
  "$arm2d/Platform/math/arm_sin_q31.c" \
  "$arm2d/Helper/Source/arm_2d_asset_circle_small.c" \
  "$arm2d/Helper/Source/arm_2d_asset_cmsis_logo.c" \
  "$arm2d/Helper/Source/arm_2d_asset_glcd_fonts.c" \
  "$arm2d/Helper/Source/arm_2d_asset_white_dot_small.c" \
  "$arm2d/Helper/Source/arm_2d_helper.c" \
  "$arm2d/Helper/Source/arm_2d_helper_built_in.c" \
  "$arm2d/Helper/Source/arm_2d_helper_control.c" \
  "$arm2d/Helper/Source/arm_2d_helper_font.c" \
  "$arm2d/Helper/Source/arm_2d_helper_pfb.c" \
  "$arm2d/Helper/Source/arm_2d_helper_scene.c" \
  "$arm2d/Helper/Source/arm_2d_helper_shape.c" \
  "$arm2d/Helper/Source/busy_wheel.c"

printf '%s\n' 'compiler phase: startup assembler (cortex-a9)' >&2
arm-none-eabi-gcc -mcpu=cortex-a9 -marm -c "$root/src/startup.S" -o "$root/build/startup.o"
printf '%s\n' 'compiler phase: C gnu17 and link (cortex-a9, CMSIS adapter)' >&2
arm-none-eabi-gcc -std=gnu17 -fms-extensions -Wno-error=int-conversion -mcpu=cortex-a9 -marm -ffreestanding -fno-builtin -O2 \
  -ffunction-sections -fdata-sections -D_RTE_ \
  -include "$root/src/cmsis_gcc_a9_compat.h" \
  -include "$root/src/RTE_Components.h" \
  -I"$root/src" \
  -I"$arm2d/Library/Include" \
  -I"$arm2d/Helper/Include" \
  -I"$arm2d/Platform/math" \
  -I"$arm2d/examples/demos" \
  -I"$arm2d/examples/common/controls" \
  -nostdlib -Wl,--build-id=none -Wl,--gc-sections -Wl,-T,"$root/linker.ld" \
  "$root/build/startup.o" "$@" -lgcc -o "$root/build/qemu-gui.elf"
arm-none-eabi-size "$root/build/qemu-gui.elf"
