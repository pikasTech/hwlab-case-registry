{
  "schemaVersion": 1,
  "baselineId": "qemu-lcd-arm2d-v1",
  "sources": {
    "arm2d": {
      "repository": "https://github.com/ARM-software/Arm-2D.git",
      "ref": "develop",
      "commit": "9439667a9055df47caf948b16a3865bd63820ac6"
    },
    "qemu": {
      "package": "qemu-system-arm",
      "machine": "vexpress-a9",
      "cpu": "cortex-a9",
      "displayController": "pl111"
    }
  },
  "toolchain": {
    "compiler": "arm-none-eabi-gcc",
    "minimumVersion": "12.3.1"
  },
  "adapter": {
    "cmsisGccA9": "src/cmsis_gcc_a9_compat.h",
    "languageStandard": "gnu17",
    "startup": "separate assembler invocation",
    "pixelFormat": "RGB565 little-endian, PL111 BGR bit configured by board adapter"
  }
}
