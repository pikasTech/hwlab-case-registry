+    tFillSrc.tRegion.tSize.iWidth = 1;
+    tFillSrc.tRegion.tSize.iHeight = 1;
+    tFillSrc.phwBuffer = &hwColour;
+
+    arm_2d_rgb16_tile_fill_only(&tFillSrc, ptTile, &tRegion);
