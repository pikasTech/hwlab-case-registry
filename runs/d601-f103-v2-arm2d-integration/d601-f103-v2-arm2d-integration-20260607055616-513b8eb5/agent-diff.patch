                               uint16_t colour)
-{ }
+{
+    int16_t local_x, local_y, local_w, local_h;
+
+    local_x = (int16_t)x;
+    local_y = (int16_t)(y - stripe_y);
+    local_w = (int16_t)width;
+    local_h = (int16_t)height;
+
+    if (local_y < 0) {
+        local_h += local_y;
+        local_y = 0;
+    }
+    if ((uint16_t)(local_y + local_h) > stripe_h) {
+        local_h = (int16_t)(stripe_h - (uint16_t)local_y);
+    }
+    if (local_h <= 0 || local_w <= 0) return;
+
+    arm_2d_rgb16_fill_colour(ptTile, NULL, local_x, local_y, local_w, local_h, colour);
