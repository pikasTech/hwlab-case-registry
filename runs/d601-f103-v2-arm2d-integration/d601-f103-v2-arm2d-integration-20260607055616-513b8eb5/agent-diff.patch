 static void arm2d_render_stripe(uint16_t y, uint16_t stripe_h, uint16_t width, uint16_t height)
-{ }
+{
+    arm_2d_tile_t tTile;
+
+    arm2d_wait();
+
+    arm2d_tile_bind(&tTile, D601_ARM2D_PFB_WIDTH, stripe_h);
+
+    arm2d_fill_local(&tTile, 0, 0, (int16_t)width, (int16_t)stripe_h, D601_C_BG);
+
+    arm2d_fill_global(&tTile, y, stripe_h, 10, 20, (uint16_t)(width - 20), 40, D601_C_BANNER);
+    arm2d_fill_global(&tTile, y, stripe_h, 10, 96, (uint16_t)(width - 20), 74, D601_C_CARD);
+    arm2d_fill_global(&tTile, y, stripe_h, 10, 170, (uint16_t)(width - 20), 40, D601_C_FOOT);
+    arm2d_fill_global(&tTile, y, stripe_h, 10, 100, (uint16_t)(width - 20), 2, D601_C_CYAN);
+
+    d601_lcd_draw_bitmap(0, y, D601_ARM2D_PFB_WIDTH, stripe_h, &s_pfb[0][0]);
+}
 
 static void arm2d_fps_text(char *text, uint32_t fps)
-{ }
+{
+    if (fps < 10) {
+        text[0] = (char)(0x30 + fps);
+        text[1] = 0;
+    } else if (fps < 100) {
+        text[0] = (char)(0x30 + fps / 10);
+        text[1] = (char)(0x30 + fps % 10);
+        text[2] = 0;
+    } else {
+        text[0] = 0x39;
+        text[1] = 0x39;
+        text[2] = 0x2B;
+        text[3] = 0;
+    }
+}
 
 static void arm2d_draw_fps(uint16_t height)
-{ }
+{
+    char fps_str[8];
+    uint32_t now = HAL_GetTick();
+
+    if (s_fps_window_ms == 0) {
+        s_fps_window_ms = now;
+    }
+
+    if (now - s_fps_window_ms >= 1000) {
+        s_fps_value = s_fps_frame_count;
+        s_fps_frame_count = 0;
+        s_fps_window_ms = now;
+    }
+
+    arm2d_fps_text(fps_str, s_fps_value);
+    d601_lcd_show_string(180, height - 20, fps_str, D601_C_GREEN, D601_C_FOOT, 2);
+}
 
 void d601_arm2d_demo_show(void)
