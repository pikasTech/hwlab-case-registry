 #define D601_ARM2D_PFB_WIDTH 240U
 #define D601_ARM2D_PFB_LINES 32U
+
 #define D601_RGB565(__R, __G, __B) \
     (uint16_t)((((uint16_t)(__R) & 0xF8U) << 8) | (((uint16_t)(__G) & 0xFCU) << 3) | ((uint16_t)(__B) >> 3))
 
