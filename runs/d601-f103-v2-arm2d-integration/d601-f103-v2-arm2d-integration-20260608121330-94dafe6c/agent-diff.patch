 static void arm2d_fps_text(char *text, uint32_t fps)
-{ }
+{
+    uint32_t n = fps;
+    uint8_t idx = 0;
+    if (n == 0) {
+        text[0] = '0';
+        text[1] = '\0';
+        return;
+    }
+    char buf[16];
+    uint8_t i = 0;
+    while (n > 0) {
+        buf[i++] = (char)('0' + (n % 10));
+        n /= 10;
+    }
+    while (i > 0) {
+        text[idx++] = buf[--i];
+    }
+    text[idx] = '\0';
+}
 
