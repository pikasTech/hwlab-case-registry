diff --git a/src/demo_glue.c b/src/demo_glue.c
new file mode 100644
index 0000000..b7b9925
--- /dev/null
+++ b/src/demo_glue.c
@@ -0,0 +1,11 @@
+#include <arm_2d.h>
+#include <arm_math.h>
+
+void arm2d_cmsis_demo(void)
+{
+    float32_t input[4] = { 1.0f, 2.0f, 3.0f, 4.0f };
+    float32_t output[4];
+    arm_2d_init();
+    arm_add_f32(input, input, output, 4);
+    (void)output;
+}
